# Backend
DATABASE_URL=mock://pulycort
APP_REFRESH_SECONDS=30
SHIFT_SCHEDULE=manana=06:00-14:00,tarde=14:00-22:00,noche=22:00-06:00
SQL_TABLE_CONFIG=backend/config/sql_tables.example.json
SQL_ROW_LIMIT=5000
# Semantica de la cantidad de cada parte de maquina (pendiente de confirmar
# con INDASEL): cumulative = acumulado del pedido, incremental = solo el parte.
QUANTITY_MODE=cumulative
# Horas sin senal para considerar un pedido parado (con planta activa o en turno).
STALLED_AFTER_HOURS=6
MAPPING_ACTIONS_PATH=backend/local_state/mapping_actions.json
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Frontend
VITE_API_BASE=
